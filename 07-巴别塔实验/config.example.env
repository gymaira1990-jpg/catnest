# 巴别塔实验 · 配置参考
# Babel Experiment · Configuration Reference
#
# 复制此文件为 .env 并根据需要修改
# Copy this file to .env and customize

# ─── 画布服务器 ───
PORT=8800                          # 画布监听端口
CANVAS_WIDTH=100                   # 画布宽度 (像素)
CANVAS_HEIGHT=100                  # 画布高度 (像素)
PIXEL_SIZE=4                       # 每个像素的显示尺寸
GROWTH_THRESHOLD=0.7               # 画布成长阈值 (填充率 > 此值则成长)
GROWTH_SIZE=30                     # 每次成长增加的尺寸
AUTO_GROWTH=true                   # 是否自动成长
FLASK_SECRET=change-me-to-random   # 会话密钥 (生产环境请修改)

# ─── 染坊客户端 (workshop.py) ───
# 见 workshop_config.json

# ─── 监控 (monitor/) ───
# MONITOR_CANVAS_URL=http://127.0.0.1:8800
# MONITOR_STATUS_FILE=/var/www/html/status.json

# ─── 部署 (deploy/) ───
# NGINX_DOMAIN=your-domain.com
# NGINX_SSL_CERT=/etc/letsencrypt/live/your-domain.com/fullchain.pem
# NGINX_SSL_KEY=/etc/letsencrypt/live/your-domain.com/privkey.pem
